{
  "name": "duo",
  "version": "0.3.0",
  "private": true,
  "description": "Claude Code and Codex in one desktop app: chat with either, run them side by side, or let them pair-program, debate and review each other.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai",
    "anthropic",
    "ai",
    "agents",
    "pair-programming",
    "code-review",
    "electron"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "duo": "bin/duo.js",
    "duo-safe": "bin/duo-safe.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.gui.json",
    "check": "npm run typecheck && npm test",
    "dev": "node src/server/main.ts --port 47821 --token dev --rebuild",
    "gui": "node bin/duo.js gui",
    "smoke": "node scripts/smoke.mjs",
    "build": "node -e \"import('./src/server/build.ts').then(m=>m.buildGui(true))\"",
    "postinstall": "node node_modules/electron/install.js",
    "release:bundle": "node scripts/release.mjs",
    "release:prepare": "npm run check && npm run build && npm run release:bundle"
  },
  "dependencies": {
    "@enderfga/claw-orchestrator": "7.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@openai/codex": "0.159.0",
    "@preact/signals": "^2.11.2",
    "commander": "^12.1.0",
    "dompurify": "^3.4.16",
    "electron": "^44.5.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "author": "Aditya Shrivastav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Audatic07/duo.git"
  },
  "homepage": "https://github.com/Audatic07/duo#readme",
  "bugs": {
    "url": "https://github.com/Audatic07/duo/issues"
  }
}
